<main class="page">
<section class="container spa-hero"><div class="stack"><p class="eyebrow">{{ site.title }}</p><h1 data-revel-text="up split=words">[[Prendre soin de soi, simplement.||Taking care of yourself, simply.]]</h1><p class="lead">{{ site.description }}</p><div class="actions"><a class="btn" href="#[[reserver||book]]">[[Réserver un soin||Book a treatment]]</a><a class="btn btn--ghost" href="#[[coffrets||gifts]]">[[Offrir un coffret||Give a gift card]]</a></div></div><img src="@@hero:1200@@" alt="@@alt:hero@@" data-revel-appear="fade dur=1.2"></section>
<section class="section section--surface" id="[[soins||treatments]]"><div class="container menu-spa"><x-use c="section-head" variant="center" eyebrow="[[Soins||Treatments]]" title="[[La carte des soins||Treatment menu]]"></x-use><div class="tabs" data-revel-tabs><div class="tabs__list" role="tablist"><button class="tab" type="button" data-revel-tab>[[Visage||Face]]</button><button class="tab" type="button" data-revel-tab>[[Massages||Massages]]</button><button class="tab" type="button" data-revel-tab>[[Mains et pieds||Hands and feet]]</button></div><div class="tabs__panel" data-revel-panel><x-use c="treatment" name="[[Soin éclat||Glow facial]]" time="45 min" price="[[65 €||$70]]"></x-use><x-use c="treatment" name="[[Soin profond||Deep facial]]" time="75 min" price="[[95 €||$100]]"></x-use></div><div class="tabs__panel" data-revel-panel><x-use c="treatment" name="[[Massage relaxant||Relaxing massage]]" time="60 min" price="[[80 €||$85]]"></x-use><x-use c="treatment" name="[[Massage aux pierres chaudes||Hot stone massage]]" time="75 min" price="[[105 €||$110]]"></x-use></div><div class="tabs__panel" data-revel-panel><x-use c="treatment" name="[[Manucure||Manicure]]" time="40 min" price="[[35 €||$38]]"></x-use><x-use c="treatment" name="[[Beauté des pieds||Pedicure]]" time="50 min" price="[[45 €||$48]]"></x-use></div></div></div></section>
<section class="section"><div class="container moods"><img src="@@care1:900@@" alt="@@alt:care1@@" data-revel-appear="up"><img src="@@care2:900@@" alt="@@alt:care2@@" data-revel-appear="up delay=0.1"><img src="@@care3:900@@" alt="@@alt:care3@@" data-revel-appear="up delay=0.2"></div></section>
<section class="section section--tight" id="[[coffrets||gifts]]"><div class="container gift"><img class="media media--wide" src="@@products:1200@@" alt="@@alt:products@@"><div class="stack"><p class="eyebrow">[[Coffrets cadeaux||Gift cards]]</p><h2>[[Offrez un moment de calme||Give a moment of calm]]</h2><p class="lead">[[Valables un an sur tous les soins, envoyés par e-mail.||Valid one year on all treatments, sent by email.]]</p><div class="actions"><a class="btn" href="{{ site.gift }}">[[Acheter un coffret||Buy a gift card]]</a></div></div></div></section>
<section class="section section--surface"><div class="container grid grid--2"><x-use c="testimonial" quote="[[Un lieu hors du temps, des mains expertes.||A timeless place, expert hands.]]" name="Julie M." role="[[Cliente fidèle||Regular client]]" avatar="@@saas/avatar1:160@@"></x-use><x-use c="testimonial" quote="[[Le massage aux pierres chaudes est incroyable.||The hot stone massage is incredible.]]" name="Nadia B." role="[[Avis Google||Google review]]" avatar="@@saas/avatar3:160@@"></x-use></div></section>
<section class="section" id="[[reserver||book]]"><div class="container"><x-use c="section-head" variant="center" eyebrow="[[Réserver||Book]]" title="[[Demander un rendez-vous||Request an appointment]]" text="[[Nous confirmons par SMS dans la journée.||We confirm by text the same day.]]"></x-use><form class="form form--narrow beauty-form" data-revel-form="[[rendez-vous||appointment]]"><div class="form__row"><label class="field"><span class="field__label">[[Soin||Treatment]]</span><select class="field__input" name="[[soin||treatment]]"><option>[[Soin éclat||Glow facial]]</option><option>[[Massage relaxant||Relaxing massage]]</option><option>[[Manucure||Manicure]]</option></select></label><label class="field"><span class="field__label">Date</span><input class="field__input" type="date" name="date"></label></div><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" required></label><label class="field"><span class="field__label">[[Téléphone||Phone]]</span><input class="field__input" type="tel" name="[[telephone||phone]]" required></label></div><button class="btn" type="submit">[[Envoyer||Send]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
