<main class="page"><section class="product"><div class="container product__grid"><div class="product__gallery"><img class="product__main" src="{{ image }}" alt="">{% for photo in gallery %}<img src="{{ photo }}" alt="" loading="lazy">{% endfor %}</div><div class="product__info"><p class="eyebrow">{{ category }}</p><h1>{{ title }}</h1><p class="product__price">[[<span>{{ price }}</span><span> €</span>||<span>$</span><span>{{ price }}</span>]]</p><p class="product__body">{{ description }}</p><div class="product__buy"><button class="btn" type="button" data-revel-cart-add data-revel-product="{{ title }}" data-revel-price="{{ price }}">[[Ajouter au panier||Add to cart]]</button>{% if stripe %}<a class="btn btn--ghost" href="{{ stripe }}">[[Payer par carte (Stripe)||Pay by card (Stripe)]]</a>{% endif %}{% if paypal %}<a class="btn btn--ghost" href="{{ paypal }}">[[Payer avec PayPal||Pay with PayPal]]</a>{% endif %}</div><p class="product__note">[[Fait main : chaque pièce est unique. Expédition sous 5 jours.||Handmade: every piece is unique. Ships within 5 days.]]</p><div class="prose">{{ content | safe }}</div></div></div></section></main>
