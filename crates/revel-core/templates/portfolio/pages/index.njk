<main class="page">
<section class="intro-type"><div class="container"><h1 data-revel-text="up split=words">[[Je dessine des identités qui <em>durent</em>.||I design identities that <em>last</em>.]]</h1><div class="intro-type__meta" data-revel-appear="up delay=0.3"><p>{{ site.description }}</p><p>{{ site.address }}</p></div></div></section>
<section class="section section--tight"><div class="container"><div class="work">{% for item in collections.projects | sort(attribute="order") %}<x-use c="work-item" x-image="item.data.image" x-title="item.data.title" x-year="item.data.year" x-category="item.data.category" x-link="item.url" x-offset="item.data.offset"></x-use>{% endfor %}</div></div></section>
</main>
