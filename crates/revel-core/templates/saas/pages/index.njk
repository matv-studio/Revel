<main class="page">
<section class="launch"><div class="container"><p class="badge" data-revel-appear="fade"><strong>[[Nouveau||New]]</strong> [[Facturation automatique||Automatic invoicing]]</p><h1 data-revel-text="up split=words">[[Vos projets, enfin sous contrôle.||Your projects, finally under control.]]</h1><p class="lead" data-revel-appear="up delay=0.3">{{ site.description }}</p><div class="actions" data-revel-appear="up delay=0.4"><a class="btn" href="#[[essai||trial]]">[[Essayer 14 jours||Try it for 14 days]]</a><a class="btn btn--ghost" href="#[[fonctions||features]]">[[Voir les fonctions||See features]]</a></div><div class="screen" data-revel-appear="up delay=0.5 dur=1"><img src="@@screen:2000@@" alt="@@alt:screen@@"></div><div class="logos-row"><span>Nordline</span><span>Kōdo</span><span>Polaris</span><span>Vallée</span><span>Sève</span></div></div></section>
<section class="section" id="[[fonctions||features]]"><div class="container"><x-use c="section-head" variant="center" eyebrow="[[Fonctions||Features]]" title="[[Tout ce qu'il faut, rien de trop||Everything you need, nothing more]]"></x-use><div class="grid grid--3"><x-use c="feature" title="[[Planning visuel||Visual planning]]" text="[[Glissez les tâches, voyez la charge de chacun.||Drag tasks, see everyone's workload.]]" data-revel-appear="up">@@icon:calendrier@@</x-use><x-use c="feature" title="[[Temps passé||Time tracking]]" text="[[Un clic pour démarrer, un rapport par client.||One click to start, one report per client.]]" data-revel-appear="up delay=0.1">@@icon:horloge@@</x-use><x-use c="feature" title="[[Factures||Invoices]]" text="[[Générées depuis le temps passé, envoyées par e-mail.||Generated from tracked time, sent by email.]]" data-revel-appear="up delay=0.2">@@icon:document@@</x-use><x-use c="feature" title="[[Rapports||Reports]]" text="[[Marge par projet, en temps réel.||Margin per project, in real time.]]" data-revel-appear="up">@@icon:graphique@@</x-use><x-use c="feature" title="[[Équipe||Team]]" text="[[Rôles, droits et commentaires.||Roles, permissions and comments.]]" data-revel-appear="up delay=0.1">@@icon:equipe@@</x-use><x-use c="feature" title="[[Sécurité||Security]]" text="[[Données chiffrées, hébergées en Europe.||Encrypted data, hosted in Europe.]]" data-revel-appear="up delay=0.2">@@icon:cadenas@@</x-use></div></div></section>
