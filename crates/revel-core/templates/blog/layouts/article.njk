<div class="progress" data-revel-progress="page" aria-hidden="true"><div class="progress__fill"></div></div>
<main class="page"><article class="article"><header class="article__head"><p class="eyebrow article__category">{{ category }}</p><h1 class="article__title">{{ title }}</h1><p class="article__summary">{{ description }}</p><p class="article__date">{{ date | date_text(locale, "long") }}</p></header><figure class="article__cover"><img src="{{ image }}" alt=""></figure><div class="article__body">{{ content | safe }}</div><div class="article__author"><x-use c="author" photo="@@author:200@@" name="Jeanne Rivière" bio="[[Je voyage lentement et j'écris sur ce que je découvre.||I travel slowly and write about what I find.]]"></x-use></div></article>
<section class="related"><div class="container"><x-use c="section-head" eyebrow="[[À lire aussi||Read next]]" title="[[D'autres articles||More posts]]"></x-use><div class="posts">{% for item in (collections.articles | without(page.url) | sort(attribute="date", reverse=true))[:3] %}<x-use c="card" variant="flat" x-image="item.data.image" x-title="item.data.title" x-link="item.url"><p>{{ item.data.description }}</p></x-use>{% endfor %}</div></div></section>
<x-use c="newsletter" id="newsletter"></x-use></main>
