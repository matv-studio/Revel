<main class="page"><section class="soon"><img class="soon__bg" src="@@bg:2200@@" alt="" data-revel-scroll="parallax amount=20"><p class="soon__brand">{{ site.title }}</p><div><h1 data-revel-text="up split=words">[[Bientôt. Promis.||Soon. Promise.]]</h1><p class="lead">{{ site.description }}</p><form data-revel-form="[[lancement||launch]]"><input class="field__input" type="email" name="email" autocomplete="email" placeholder="[[votre@adresse.fr||you@example.com]]" aria-label="[[Adresse e-mail||Email address]]" required><button class="btn" type="submit">[[Me prévenir||Notify me]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div><div class="soon__foot"><a href="mailto:{{ site.email }}">{{ site.email }}</a><span>{% for lien in site.menus.social %}<a href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</span></div></section></main>
