<header class="navbar"><nav class="navbar__inner"><a class="navbar__brand" href="/">{{ site.title }}</a><button class="navbar__toggle" type="button" aria-expanded="false" data-revel-on="click class:is-open parent">[[Menu||Menu]]</button><div class="navbar__menu">{% for lien in site.menus.main %}<a class="navbar__link" href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}{% if show_cta %}<a class="btn btn--small navbar__cta" href="{{ cta_link }}">{{ cta }}</a>{% endif %}</div></nav></header>
