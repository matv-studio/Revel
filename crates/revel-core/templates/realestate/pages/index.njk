<main class="page">
<section class="re-hero"><img class="re-hero__image" src="@@hero:2000@@" alt="@@alt:hero@@"><div class="container"><p class="eyebrow">{{ site.title }}</p><h1 data-revel-text="up split=words">[[Trouvez le lieu qui vous ressemble.||Find the place that feels like you.]]</h1><p class="lead">{{ site.description }}</p></div></section>
<section class="section"><div class="container"><x-use c="section-head" eyebrow="[[Nos biens||Our listings]]" title="[[À vendre en ce moment||For sale right now]]"></x-use><div class="filters" data-revel-filters="type"><button class="filter" type="button" data-revel-filter="">[[Tous||All]]</button><button class="filter" type="button" data-revel-filter="[[Maison||House]]">[[Maisons||Houses]]</button><button class="filter" type="button" data-revel-filter="[[Appartement||Apartment]]">[[Appartements||Apartments]]</button><button class="filter" type="button" data-revel-filter="Loft">Lofts</button></div><div class="listings" data-revel-more="6">{% for item in collections.listings | sort(attribute="order") %}<div data-revel-tags="{{ item.data.type }}"><x-use c="listing-card" x-image="item.data.image" x-title="item.data.title" x-price="item.data.price" x-place="item.data.place" x-area="item.data.area" x-rooms="item.data.rooms" x-link="item.url"></x-use></div>{% endfor %}</div></div></section>
<section class="section section--surface"><div class="container grid grid--3"><x-use c="feature" title="[[Estimation en 48 h||Valuation in 48 h]]" text="[[Un avis chiffré et argumenté, sans engagement.||A detailed figure, no strings attached.]]">@@icon:maison@@</x-use><x-use c="feature" title="[[Visites virtuelles||Virtual tours]]" text="[[Photos et vidéos professionnelles pour chaque bien.||Professional photos and video for every listing.]]">@@icon:camera@@</x-use><x-use c="feature" title="[[Un conseiller dédié||A dedicated advisor]]" text="[[Du premier rendez-vous à la signature.||From first meeting to signing.]]">@@icon:utilisateur@@</x-use></div></section>
</main>
