  "preview": "hero",
  "palette": ["#f3eee6", "#2b2420", "#9a5b34"],
  "features": ["cms", "cart", "stripe", "paypal", "filters", "dark"],
  "fonts": [ { "family": "Cormorant Garamond", "variants": ["500", "600"] }, { "family": "DM Sans", "variants": ["400", "500", "700"] } ],
  "settings": { "smooth_scroll": true },
  "site": {
    "description": "[[Céramiques et objets du quotidien, faits à la main dans notre atelier.||Ceramics and everyday objects, handmade in our workshop.]]",
    "email": "[[commandes@exemple.fr||orders@example.com]]",
    "phone": "[[04 78 00 00 00||+1 555 010 4455]]",
    "address": "[[3 place du Marché, 26000 Valence||3 Market Square, Hudson, NY]]",
    "menus": {
      "main": [
        { "label": "[[Boutique||Shop]]", "url": "[[/boutique/||/shop/]]" },
        { "label": "[[L'atelier||Workshop]]", "url": "[[/atelier/||/workshop/]]" },
        { "label": "[[Panier||Cart]]", "url": "[[/panier/||/cart/]]" }
      ],
      "social": [ { "label": "Instagram", "url": "https://www.instagram.com/" }, { "label": "Pinterest", "url": "https://www.pinterest.com/" } ]
    }
  },
  "kit": ["navbar", "footer", "section-head", "feature", "faq"],
  "components": [
    { "id": "product-card", "name": "[[Carte produit||Product card]]",
      "props": [
        { "name": "image", "label": "Image", "type": "image", "default": "" },
        { "name": "title", "label": "[[Produit||Product]]", "type": "text", "default": "[[Produit||Product]]" },
        { "name": "price", "label": "[[Prix||Price]]", "type": "text", "default": "0" },
        { "name": "link", "label": "[[Lien||Link]]", "type": "link", "default": "#" }
      ] }
  ],
  "layouts": [ { "id": "base" }, { "id": "product", "parent": "base" } ],
