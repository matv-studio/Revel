<main class="page">
<section class="hero-food"><img class="hero-food__image" src="@@hero:2000@@" alt="@@alt:hero@@"><div class="hero-food__text"><p class="eyebrow" data-revel-appear="fade">[[Bistrot de saison||Seasonal bistro]]</p><h1 data-revel-text="up split=words">[[On cuisine ce que le marché nous donne.||We cook what the market gives us.]]</h1><p class="lead" data-revel-appear="up delay=0.3">{{ site.description }}</p><div class="actions" data-revel-appear="up delay=0.4"><a class="btn" href="[[/reserver/||/book/]]">[[Réserver une table||Book a table]]</a><a class="btn btn--ghost" href="#[[carte||menu]]">[[Voir la carte||See the menu]]</a></div></div></section>
<section class="section" id="[[maison||about]]"><div class="container intro-food"><div class="stack"><p class="eyebrow">[[La maison||The house]]</p><h2>[[Une cuisine simple, des produits choisis||Simple cooking, chosen produce]]</h2><p class="lead">[[Depuis 2011, notre chef travaille avec une vingtaine de producteurs à moins de cent kilomètres. La carte change chaque semaine.||Since 2011 our chef has worked with some twenty growers within a hundred kilometres. The menu changes every week.]]</p></div><div class="intro-food__images"><img class="media media--tall" src="@@chef:800@@" alt="@@alt:chef@@" data-revel-appear="up"><img class="media media--tall" src="@@dish2:800@@" alt="@@alt:dish2@@" data-revel-appear="up delay=0.15"></div></div></section>
<section class="section section--surface" id="[[carte||menu]]"><div class="container menu"><x-use c="section-head" variant="center" eyebrow="[[La carte||The menu]]" title="[[Cette semaine||This week]]"></x-use><div class="tabs" data-revel-tabs><div class="tabs__list" role="tablist"><button class="tab" type="button" data-revel-tab>[[Entrées||Starters]]</button><button class="tab" type="button" data-revel-tab>[[Plats||Mains]]</button><button class="tab" type="button" data-revel-tab>Desserts</button><button class="tab" type="button" data-revel-tab>[[Vins||Wines]]</button></div><div class="tabs__panel" data-revel-panel><x-use c="dish" name="[[Velouté de courge, noisettes||Squash soup, hazelnuts]]" text="[[Huile de sauge, pain grillé||Sage oil, toasted bread]]" price="9"></x-use><x-use c="dish" variant="chef" name="[[Tartare de daurade||Sea bream tartare]]" text="[[Agrumes, fenouil croquant||Citrus, crisp fennel]]" price="14"></x-use><x-use c="dish" name="[[Burrata de la semaine||Burrata of the week]]" text="[[Tomates anciennes, basilic||Heirloom tomatoes, basil]]" price="12"></x-use></div><div class="tabs__panel" data-revel-panel><x-use c="dish" variant="chef" name="[[Pavé de saumon||Salmon fillet]]" text="[[Légumes rôtis, beurre blanc||Roasted vegetables, beurre blanc]]" price="24"></x-use><x-use c="dish" name="[[Bavette grillée||Grilled flank steak]]" text="[[Frites maison, salade||Homemade fries, salad]]" price="22"></x-use><x-use c="dish" name="[[Risotto aux champignons||Mushroom risotto]]" text="[[Parmesan affiné 24 mois||24-month parmesan]]" price="19"></x-use></div><div class="tabs__panel" data-revel-panel><x-use c="dish" name="[[Tarte fine aux pommes||Thin apple tart]]" text="[[Glace vanille||Vanilla ice cream]]" price="9"></x-use><x-use c="dish" name="[[Mousse au chocolat||Chocolate mousse]]" text="[[Fleur de sel||Sea salt]]" price="8"></x-use></div><div class="tabs__panel" data-revel-panel><x-use c="dish" name="[[Blanc du Luberon||White from Luberon]]" text="[[Le verre||By the glass]]" price="7"></x-use><x-use c="dish" name="[[Rouge du Languedoc||Red from Languedoc]]" text="[[Le verre||By the glass]]" price="8"></x-use><x-use c="dish" name="[[Cocktail de la maison||House cocktail]]" text="[[Romarin, orange amère||Rosemary, bitter orange]]" price="11"></x-use></div></div></div></section>
<section class="section"><div class="container"><div class="gallery-food" data-revel-masonry><img src="@@dish1:900@@" alt="@@alt:dish1@@" loading="lazy"><img src="@@terrace:900@@" alt="@@alt:terrace@@" loading="lazy"><img src="@@dish3:900@@" alt="@@alt:dish3@@" loading="lazy"><img src="@@drinks:900@@" alt="@@alt:drinks@@" loading="lazy"><img src="@@dish4:900@@" alt="@@alt:dish4@@" loading="lazy"><img src="@@dish2:900@@" alt="@@alt:dish2@@" loading="lazy"></div></div></section>
<section class="section section--surface"><div class="container"><div class="grid grid--2"><x-use c="testimonial" quote="[[Le meilleur poisson du quartier, et un accueil qui donne envie de revenir.||The best fish in the area, and a welcome that makes you want to come back.]]" name="Marc D." role="[[Avis Google||Google review]]" avatar="@@saas/avatar2:160@@"></x-use><x-use c="testimonial" quote="[[Une carte courte, tout est bon. La terrasse le soir est magique.||A short menu where everything is good. The terrace at night is magical.]]" name="Sophie L." role="[[Avis Google||Google review]]" avatar="@@saas/avatar3:160@@"></x-use></div></div></section>
<section class="section"><div class="container info-band"><div><h3>[[Horaires||Hours]]</h3><p>{{ site.hours }}</p></div><div><h3>[[Adresse||Address]]</h3><p>{{ site.address }}</p></div><div><h3>[[Réservation||Bookings]]</h3><a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></div></div></section>
</main>
