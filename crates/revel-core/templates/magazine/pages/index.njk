<main class="page"><div class="container">
<header class="masthead"><h1 class="masthead__title">{{ site.title }}</h1><div class="masthead__line"><span>{{ site.description }}</span><span>[[Édition de la semaine||This week's edition]]</span></div></header>
<section class="front">{% for item in (collections.stories | sort(attribute="date", reverse=true))[:1] %}<a class="lead-story" href="{{ item.url }}"><img src="{{ item.data.image }}" alt=""><p class="kicker">{{ item.data.section }}</p><h2>{{ item.data.title }}</h2><p class="lead">{{ item.data.description }}</p></a>{% endfor %}<div class="side-stories">{% for item in (collections.stories | sort(attribute="date", reverse=true))[:5] %}{% if not loop.first %}<a class="side-story" href="{{ item.url }}"><p class="kicker">{{ item.data.section }}</p><h3>{{ item.data.title }}</h3></a>{% endif %}{% endfor %}</div></section>
<section class="section" id="[[rubriques||sections]]"><div class="filters" data-revel-filters="rubrique"><button class="filter" type="button" data-revel-filter="">[[Tout||All]]</button><button class="filter" type="button" data-revel-filter="Culture">Culture</button><button class="filter" type="button" data-revel-filter="Sciences">[[Sciences||Science]]</button><button class="filter" type="button" data-revel-filter="[[Société||Society]]">[[Société||Society]]</button><button class="filter" type="button" data-revel-filter="[[Voyage||Travel]]">[[Voyage||Travel]]</button></div><div class="stories" data-revel-more="8">{% for item in collections.stories | sort(attribute="date", reverse=true) %}<a class="story-card" href="{{ item.url }}" data-revel-tags="{{ item.data.section }}"><img src="{{ item.data.image }}" alt="" loading="lazy"><p class="kicker">{{ item.data.section }}</p><h3>{{ item.data.title }}</h3><p>{{ item.data.description }}</p></a>{% endfor %}</div></section>
<section class="subscribe" id="[[abonnement||subscribe]]"><h2>[[La lettre du vendredi||The Friday letter]]</h2><p class="muted">[[Les cinq articles à ne pas manquer, chaque semaine.||Five stories not to miss, every week.]]</p><form data-revel-form="[[abonnement||subscribe]]"><input class="field__input" type="email" name="email" autocomplete="email" placeholder="[[votre@adresse.fr||you@example.com]]" aria-label="[[Adresse e-mail||Email address]]" required><button class="btn" type="submit">[[S'abonner||Subscribe]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></section>
</div></main>
