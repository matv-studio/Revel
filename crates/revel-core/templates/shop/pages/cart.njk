<main class="page">
<section class="page-hero section--tight"><div class="container"><p class="eyebrow">[[Panier||Cart]]</p><h1>[[Votre commande||Your order]]</h1></div></section>
<section class="section section--tight"><div class="container"><div class="cart" data-revel-cart="[[EUR||USD]]"><ul class="cart__lines"><li class="cart__line" data-revel-cart-item><span class="cart__name" data-revel-cart-name>[[Produit||Product]]</span><span class="cart__qty"><button class="cart__button" type="button" aria-label="[[Retirer un||Remove one]]" data-revel-cart-minus>−</button><span data-revel-cart-qty>1</span><button class="cart__button" type="button" aria-label="[[Ajouter un||Add one]]" data-revel-cart-plus>+</button></span><span class="cart__price" data-revel-cart-price>0</span><button class="cart__button" type="button" aria-label="[[Retirer du panier||Remove from cart]]" data-revel-cart-remove>×</button></li></ul><p class="cart__empty" data-revel-cart-empty>[[Votre panier est vide.||Your cart is empty.]]</p><p class="cart__total">Total : <strong data-revel-cart-total>0</strong></p><form class="form cart__order" data-revel-form="[[commande||order]]"><input type="hidden" name="[[commande||order]]" data-revel-cart-field><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" autocomplete="name" required></label><label class="field"><span class="field__label">[[E-mail||Email]]</span><input class="field__input" type="email" name="email" autocomplete="email" required></label></div><label class="field"><span class="field__label">[[Adresse de livraison||Shipping address]]</span><textarea class="field__input" name="[[adresse||address]]" rows="3" required></textarea></label><button class="btn" type="submit">[[Envoyer la commande||Send the order]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></div></section>
</main>
