<main class="page">
<section class="fit-hero"><img class="fit-hero__image" src="@@hero:2000@@" alt="@@alt:hero@@"><div class="container"><p class="eyebrow">{{ site.address }}</p><h1 data-revel-text="up split=words">[[Plus fort||Stronger]] <span>[[chaque semaine.||every week.]]</span></h1><p class="lead">{{ site.description }}</p><div class="actions"><a class="btn" href="#[[essai||trial]]">[[Réserver mon essai gratuit||Book my free trial]]</a></div></div></section>
<section class="section" id="[[cours||classes]]"><div class="container"><x-use c="section-head" eyebrow="[[Planning||Schedule]]" title="[[Les cours de la semaine||This week's classes]]"></x-use><div class="tabs" data-revel-tabs><div class="tabs__list" role="tablist"><button class="tab" type="button" data-revel-tab>[[Lun · Mer · Ven||Mon · Wed · Fri]]</button><button class="tab" type="button" data-revel-tab>[[Mar · Jeu||Tue · Thu]]</button><button class="tab" type="button" data-revel-tab>[[Week-end||Weekend]]</button></div><div class="tabs__panel" data-revel-panel><div class="class-row"><span>07:00</span><strong>Cross training</strong><em>45 min</em></div><div class="class-row"><span>12:30</span><strong>[[Yoga dynamique||Power yoga]]</strong><em>60 min</em></div><div class="class-row"><span>18:30</span><strong>Boxing</strong><em>60 min</em></div><div class="class-row"><span>20:00</span><strong>[[Mobilité||Mobility]]</strong><em>30 min</em></div></div><div class="tabs__panel" data-revel-panel><div class="class-row"><span>07:00</span><strong>[[Course en groupe||Run club]]</strong><em>45 min</em></div><div class="class-row"><span>12:30</span><strong>HIIT</strong><em>30 min</em></div><div class="class-row"><span>18:30</span><strong>[[Musculation guidée||Strength]]</strong><em>60 min</em></div></div><div class="tabs__panel" data-revel-panel><div class="class-row"><span>09:00</span><strong>[[Yoga doux||Gentle yoga]]</strong><em>60 min</em></div><div class="class-row"><span>10:30</span><strong>Cross training</strong><em>60 min</em></div><div class="class-row"><span>17:00</span><strong>Boxing</strong><em>60 min</em></div></div></div></div></section>
<section class="section section--surface" id="coachs"><div class="container split"><div class="duo-img"><img src="@@class1:900@@" alt="@@alt:class1@@" data-revel-appear="up"><img src="@@class2:900@@" alt="@@alt:class2@@" data-revel-appear="up delay=0.15"></div><div class="stack"><p class="eyebrow">Coachs</p><h2>[[Des coachs diplômés, à vos côtés||Certified coaches by your side]]</h2><div class="grid grid--2"><x-use c="member" photo="@@coach1:700@@" name="Inès" role="[[Boxe, HIIT||Boxing, HIIT]]"></x-use><x-use c="member" photo="@@coach2:700@@" name="Malik" role="[[Force, mobilité||Strength, mobility]]"></x-use></div></div></div></section>
<section class="section" id="[[tarifs||pricing]]"><div class="container"><x-use c="section-head" eyebrow="[[Abonnements||Memberships]]" title="[[Sans engagement||No commitment]]"></x-use><div class="grid grid--3"><x-use c="price" plan="[[10 séances||10 classes]]" price="[[150 €||$160]]" period="" cta="[[Acheter||Buy]]" x-link="site.join"><ul class="price__list"><li>[[Valable 6 mois||Valid 6 months]]</li><li>[[Tous les cours||All classes]]</li></ul></x-use><x-use c="price" variant="featured" plan="[[Illimité||Unlimited]]" price="[[69 €||$75]]" period="[[/mois||/month]]" cta="[[S'abonner||Join]]" x-link="site.join"><ul class="price__list"><li>[[Cours illimités||Unlimited classes]]</li><li>[[Accès libre à la salle||Open gym access]]</li><li>[[Bilan trimestriel||Quarterly check-in]]</li></ul></x-use><x-use c="price" plan="[[Coaching privé||Personal coaching]]" price="[[60 €||$65]]" period="[[/séance||/session]]" cta="[[Réserver||Book]]" link="#[[essai||trial]]"><ul class="price__list"><li>[[Programme sur mesure||Tailored programme]]</li><li>[[Suivi par application||App follow-up]]</li></ul></x-use></div></div></section>
<section class="section section--surface" id="[[essai||trial]]"><div class="container"><x-use c="section-head" eyebrow="[[Essai||Trial]]" title="[[Votre première séance est offerte||Your first class is on us]]"></x-use><form class="form form--narrow" data-revel-form="[[essai||trial]]"><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" required></label><label class="field"><span class="field__label">[[Téléphone||Phone]]</span><input class="field__input" type="tel" name="[[telephone||phone]]" required></label></div><label class="field"><span class="field__label">[[Cours souhaité||Preferred class]]</span><select class="field__input" name="[[cours||class]]"><option>Cross training</option><option>Boxing</option><option>Yoga</option><option>HIIT</option></select></label><button class="btn" type="submit">[[Réserver||Book]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
