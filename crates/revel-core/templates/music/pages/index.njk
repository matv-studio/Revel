<main class="page">
<section class="band-hero"><img class="band-hero__image" src="@@hero:2200@@" alt="@@alt:hero@@"><div class="container"><p class="eyebrow">[[Nouvel album||New album]]</p><h1 data-revel-text="up split=chars">{{ site.title }}</h1></div></section>
<section class="section" id="[[musique||music]]"><div class="container release"><img class="release__cover" src="@@vinyl:1000@@" alt="@@alt:vinyl@@" data-revel-appear="zoom-in"><div class="stack"><p class="eyebrow">[[Sortie le 2 octobre||Out October 2]]</p><h2>[[Lumière basse||Low Light]]</h2><p class="lead">{{ site.description }}</p><figure class="player" data-revel-video=""><button class="player__cover" type="button" aria-label="[[Lire le clip||Play the video]]" data-revel-play><img class="player__image" src="@@band:1400@@" alt="@@alt:band@@"><span class="player__button" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg></span></button></figure><div class="actions">{% for lien in site.menus.social %}<a class="btn btn--ghost btn--small" href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</div></div></div></section>
<section class="section section--surface" id="[[concerts||shows]]"><div class="container"><x-use c="section-head" eyebrow="[[Tournée||Tour]]" title="[[Concerts||Shows]]"></x-use><x-use c="show" date="[[14 nov.||Nov 14]]" city="Nantes" venue="Stereolux"></x-use><x-use c="show" date="[[21 nov.||Nov 21]]" city="Paris" venue="La Cigale" variant="sold-out"></x-use><x-use c="show" date="[[28 nov.||Nov 28]]" city="Lyon" venue="[[Le Transbordeur||Transbordeur]]"></x-use><x-use c="show" date="[[5 déc.||Dec 5]]" city="[[Bruxelles||Brussels]]" venue="Botanique"></x-use></div></section>
<section class="section" id="photos"><div class="container"><x-use c="section-head" eyebrow="Photos" title="[[Sur la route||On the road]]"></x-use><div class="photos" data-revel-masonry><img src="@@crowd:1000@@" alt="@@alt:crowd@@" loading="lazy"><img src="@@guitar:1000@@" alt="@@alt:guitar@@" loading="lazy"><img src="@@band:1000@@" alt="@@alt:band@@" loading="lazy"><img src="@@vinyl:1000@@" alt="@@alt:vinyl@@" loading="lazy"><img src="@@hero:1000@@" alt="@@alt:hero@@" loading="lazy"></div></div></section>
</main>
