<main class="page">
<section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1 data-revel-text="up split=words">[[Parlons de votre projet||Let's talk about your project]]</h1><p class="lead">[[Écrivez-nous quelques lignes : nous répondons sous 48 heures.||Write us a few lines: we reply within 48 hours.]]</p></div></section>
<section class="section section--tight"><div class="container contact"><div class="contact__info"><div class="contact__item"><span>[[E-mail||Email]]</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></div><div class="contact__item"><span>[[Téléphone||Phone]]</span><a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></div><div class="contact__item"><span>[[Adresse||Address]]</span><p>{{ site.address }}</p></div></div><form class="form" data-revel-form="contact"><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="nom" autocomplete="name" required></label><label class="field"><span class="field__label">[[E-mail||Email]]</span><input class="field__input" type="email" name="email" autocomplete="email" required></label></div><label class="field"><span class="field__label">[[Entreprise||Company]]</span><input class="field__input" type="text" name="entreprise" autocomplete="organization"></label><label class="field"><span class="field__label">Message</span><textarea class="field__input" name="message" rows="6" required></textarea></label><button class="btn" type="submit">[[Envoyer||Send]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
