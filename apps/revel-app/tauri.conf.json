{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revel",
  "version": "0.2.1",
  "identifier": "app.revel-studio.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../revel-ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../revel-ui"
    },
    "frontendDist": "../revel-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Revel",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; frame-src revel-canvas: http://revel-canvas.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual website builder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
