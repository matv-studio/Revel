<main class="page">
<section class="stay-hero"><img class="stay-hero__image" src="@@hero:2200@@" alt="@@alt:hero@@"><div class="stay-hero__text"><p class="eyebrow" data-revel-appear="fade">[[Maison d'hôtes||Guest house]]</p><h1 data-revel-text="up split=words">[[Le temps ralentit ici.||Time slows down here.]]</h1></div></section>
<section class="section"><div class="container split"><div class="stack"><p class="eyebrow">[[Bienvenue||Welcome]]</p><h2>[[Une maison de famille au bord de l'eau||A family house by the water]]</h2><p class="lead">{{ site.description }} [[Petit-déjeuner du jardin, vélos et transats inclus.||Garden breakfast, bikes and deckchairs included.]]</p></div><img class="media media--wide" src="@@landscape:1400@@" alt="@@alt:landscape@@" data-revel-scroll="parallax amount=25"></div></section>
<section class="section section--surface rooms" id="[[chambres||rooms]]"><div class="container"><x-use c="section-head" eyebrow="[[Chambres||Rooms]]" title="[[Trois façons de séjourner||Three ways to stay]]"></x-use><div class="carousel" data-revel-slider=""><div class="carousel__track" data-revel-track><div class="carousel__slide"><x-use c="room" image="@@room1:900@@" name="[[Chambre Jardin||Garden room]]" price="[[dès 140 €||from $150]]" text="[[Lit double, terrasse privée sur le jardin.||Double bed, private terrace onto the garden.]]"></x-use></div><div class="carousel__slide"><x-use c="room" image="@@room2:900@@" name="[[Chambre Mer||Sea room]]" price="[[dès 190 €||from $210]]" text="[[Vue sur la mer, baignoire îlot.||Sea view, freestanding bath.]]"></x-use></div><div class="carousel__slide"><x-use c="room" image="@@room3:900@@" name="[[Suite Familiale||Family suite]]" price="[[dès 260 €||from $290]]" text="[[Deux chambres, salon, jusqu'à 5 personnes.||Two bedrooms, lounge, up to 5 guests.]]"></x-use></div></div><div class="carousel__bar"><button class="carousel__arrow" type="button" aria-label="[[Précédent||Previous]]" data-revel-prev>←</button><p class="carousel__count" data-revel-count>1 / 3</p><button class="carousel__arrow" type="button" aria-label="[[Suivant||Next]]" data-revel-next>→</button></div></div></div></section>
<section class="section" id="[[maison||house]]"><div class="container"><x-use c="section-head" eyebrow="[[La maison||The house]]" title="[[Ce qui vous attend||What awaits you]]"></x-use><div class="house"><img src="@@breakfast:900@@" alt="@@alt:breakfast@@" data-revel-appear="up"><img src="@@spa:900@@" alt="@@alt:spa@@" data-revel-appear="up delay=0.1"><img src="@@landscape:900@@" alt="@@alt:landscape@@" data-revel-appear="up delay=0.2"></div><div class="grid grid--3 house__features"><x-use c="feature" title="[[Petit-déjeuner||Breakfast]]" text="[[Fruits du jardin, pain du village.||Garden fruit, village bread.]]">@@icon:tasse@@</x-use><x-use c="feature" title="Spa" text="[[Sauna et bain nordique, sur réservation.||Sauna and hot tub, on request.]]">@@icon:goutte@@</x-use><x-use c="feature" title="[[Plage à pied||Beach on foot]]" text="[[Cinq minutes par le sentier des pins.||Five minutes along the pine path.]]">@@icon:soleil@@</x-use></div></div></section>
<section class="section section--surface"><div class="container grid grid--2"><x-use c="testimonial" quote="[[Un accueil chaleureux et la plus belle vue de la côte.||A warm welcome and the best view on the coast.]]" name="Claire et Paul" role="[[Juillet 2026||July 2026]]" avatar="@@saas/avatar1:160@@"></x-use><x-use c="testimonial" quote="[[Nous revenons chaque année, les enfants adorent le jardin.||We come back every year, the kids love the garden.]]" name="Famille Martin" role="[[Août 2026||August 2026]]" avatar="@@saas/avatar2:160@@"></x-use></div></section>
<section class="section" id="[[reserver||book]]"><div class="container booking"><div class="stack"><p class="eyebrow">[[Réserver||Book]]</p><h2>[[Vos dates||Your dates]]</h2><p class="lead">[[Nous confirmons la disponibilité sous 24 heures. Ou appelez-nous :||We confirm availability within 24 hours. Or call us:]] <a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></p></div><form class="form" data-revel-form="[[reservation||booking]]"><div class="form__row"><label class="field"><span class="field__label">[[Arrivée||Arrival]]</span><input class="field__input" type="date" name="[[arrivee||arrival]]" required></label><label class="field"><span class="field__label">[[Départ||Departure]]</span><input class="field__input" type="date" name="[[depart||departure]]" required></label></div><div class="form__row"><label class="field"><span class="field__label">[[Chambre||Room]]</span><select class="field__input" name="[[chambre||room]]"><option>[[Chambre Jardin||Garden room]]</option><option>[[Chambre Mer||Sea room]]</option><option>[[Suite Familiale||Family suite]]</option></select></label><label class="field"><span class="field__label">[[Voyageurs||Guests]]</span><input class="field__input" type="number" name="[[voyageurs||guests]]" min="1" max="5" value="2"></label></div><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" autocomplete="name" required></label><label class="field"><span class="field__label">[[E-mail||Email]]</span><input class="field__input" type="email" name="email" autocomplete="email" required></label></div><button class="btn" type="submit">[[Demander ces dates||Request these dates]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
