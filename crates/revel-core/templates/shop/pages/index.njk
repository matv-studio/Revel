<main class="page">
<section class="hero-shop"><img class="hero-shop__image" src="@@hero:2000@@" alt="@@alt:hero@@"><div class="hero-shop__text"><p class="eyebrow" data-revel-appear="up">[[Nouvelle collection||New collection]]</p><h1 data-revel-text="up split=words">[[Fait main, pour tous les jours.||Handmade, for every day.]]</h1><p class="lead" data-revel-appear="up delay=0.2">{{ site.description }}</p><div class="actions" data-revel-appear="up delay=0.3"><a class="btn" href="[[/boutique/||/shop/]]">[[Découvrir la boutique||Shop the collection]]</a></div></div></section>
<section class="section"><div class="container"><x-use c="section-head" eyebrow="[[Sélection||Selection]]" title="[[Nos pièces préférées||Our favourite pieces]]"></x-use><div class="products">{% for item in (collections.products | sort(attribute="order"))[:4] %}<x-use c="product-card" x-image="item.data.image" x-title="item.data.title" x-price="item.data.price" x-link="item.url" data-revel-appear="up"></x-use>{% endfor %}</div></div></section>
<section class="section section--tight values"><div class="container grid grid--3"><x-use c="feature" title="[[Fait à la main||Handmade]]" text="[[Chaque pièce est tournée et émaillée dans notre atelier.||Every piece is thrown and glazed in our workshop.]]">@@icon:main@@</x-use><x-use c="feature" title="[[Livraison soignée||Careful delivery]]" text="[[Emballage sans plastique, expédition sous 5 jours.||Plastic-free packaging, shipped within 5 days.]]">@@icon:cadeau@@</x-use><x-use c="feature" title="[[Retours sous 30 jours||30-day returns]]" text="[[Une pièce ne vous plaît pas ? Nous la reprenons.||Not happy with a piece? We take it back.]]">@@icon:actualiser@@</x-use></div></section>
<section class="section"><div class="container story"><img class="media media--tall" src="@@workshop:1200@@" alt="@@alt:workshop@@" data-revel-appear="left"><div class="stack"><p class="eyebrow">[[L'atelier||The workshop]]</p><h2>[[De la terre au tour, puis à votre table||From clay to wheel, then to your table]]</h2><p class="lead">[[Nous travaillons une argile locale, en petites séries, avec des émaux sans plomb.||We work local clay in small batches, with lead-free glazes.]]</p><div class="actions"><a class="btn btn--ghost" href="[[/atelier/||/workshop/]]">[[Visiter l'atelier||Visit the workshop]]</a></div></div></div></section>
</main>
