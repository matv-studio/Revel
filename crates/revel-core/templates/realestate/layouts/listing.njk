<main class="page"><section class="listing"><div class="container"><div class="listing__gallery"><img class="listing__main" src="{{ image }}" alt="">{% for photo in gallery %}<img class="listing__photo" src="{{ photo }}" alt="" loading="lazy">{% endfor %}</div><div class="listing__grid"><div><p class="eyebrow">{{ type }} · {{ place }}</p><h1>{{ title }}</h1><div class="listing__facts"><p><span>[[Prix||Price]]</span>{{ price }}</p><p><span>[[Surface||Area]]</span>{{ area }}</p><p><span>[[Pièces||Rooms]]</span>{{ rooms }}</p></div><div class="prose">{{ content | safe }}</div></div><aside class="listing__aside"><h2 class="listing__aside-title">[[Visiter ce bien||Book a viewing]]</h2><form class="form" data-revel-form="[[visite||viewing]]"><input type="hidden" name="[[bien||listing]]" value="{{ title }}"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" autocomplete="name" required></label><label class="field"><span class="field__label">[[Téléphone||Phone]]</span><input class="field__input" type="tel" name="[[telephone||phone]]" autocomplete="tel" required></label><label class="field"><span class="field__label">[[E-mail||Email]]</span><input class="field__input" type="email" name="email" autocomplete="email" required></label><button class="btn" type="submit">[[Demander une visite||Request a viewing]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></aside></div></div></section></main>
