  "pages": [
    { "id": "index", "path": "/", "name": "[[Accueil||Home]]" },
    { "id": "shop", "path": "[[/boutique/||/shop/]]", "name": "[[Boutique||Shop]]", "title": "[[Boutique||Shop]]" },
    { "id": "workshop", "path": "[[/atelier/||/workshop/]]", "name": "[[L'atelier||Workshop]]", "title": "[[L'atelier||Workshop]]" },
    { "id": "cart", "path": "[[/panier/||/cart/]]", "name": "[[Panier||Cart]]", "title": "[[Panier||Cart]]" }
  ]
