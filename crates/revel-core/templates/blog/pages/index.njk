<main class="page">
<section class="intro"><div class="container"><p class="eyebrow">[[Le carnet||The journal]]</p><h1 class="intro__title" data-revel-text="up split=words">[[Des histoires lentes, écrites sur la route.||Slow stories, written on the road.]]</h1><p class="lead">{{ site.description }}</p></div></section>
<section class="featured"><div class="container">{% for item in (collections.articles | sort(attribute="date", reverse=true))[:1] %}<a class="featured__link" href="{{ item.url }}" data-revel-appear="up"><img class="featured__image" src="{{ item.data.image }}" alt=""><div class="featured__body"><p class="eyebrow">{{ item.data.category }}</p><h2 class="featured__title">{{ item.data.title }}</h2><p class="lead">{{ item.data.description }}</p><p class="featured__meta">{{ item.data.date | date_text(locale, "long") }}</p></div></a>{% endfor %}</div></section>
<section class="section section--tight"><div class="container"><div class="posts-head"><h2>[[Tous les articles||All posts]]</h2><div class="filters" data-revel-filters="categorie"><button class="filter" type="button" data-revel-filter="">[[Tout||All]]</button><button class="filter" type="button" data-revel-filter="[[Voyage||Travel]]">[[Voyage||Travel]]</button><button class="filter" type="button" data-revel-filter="Design">Design</button><button class="filter" type="button" data-revel-filter="[[Cuisine||Food]]">[[Cuisine||Food]]</button><button class="filter" type="button" data-revel-filter="Nature">Nature</button></div></div><div class="posts" data-revel-more="6">{% for item in collections.articles | sort(attribute="date", reverse=true) %}<div data-revel-tags="{{ item.data.category }}"><x-use c="card" variant="flat" x-image="item.data.image" x-title="item.data.title" x-link="item.url"><p>{{ item.data.description }}</p></x-use></div>{% endfor %}</div><p class="empty-note" data-revel-filter-empty hidden>[[Aucun article dans cette catégorie pour l'instant.||No posts in this category yet.]]</p></div></section>
<x-use c="newsletter" id="newsletter"></x-use>
</main>
