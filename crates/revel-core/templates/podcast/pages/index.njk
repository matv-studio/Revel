<main class="page">
<section class="container pod-hero"><img class="pod-hero__cover" src="@@hero:1000@@" alt="@@alt:hero@@" data-revel-appear="zoom-in"><div class="stack"><p class="eyebrow">Podcast</p><h1 data-revel-text="up split=words">[[Le métier que j'ai choisi||The work I chose]]</h1><p class="lead">{{ site.description }}</p><div class="platforms" id="[[ecouter||listen]]">{% for lien in site.menus.social %}<a class="btn btn--small btn--ghost" href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</div></div></section>
<section class="section section--tight"><div class="container"><x-use c="section-head" eyebrow="[[Épisodes||Episodes]]" title="[[Derniers épisodes||Latest episodes]]"></x-use><div data-revel-more="5">{% for item in collections.episodes | sort(attribute="date", reverse=true) %}<a class="episode-row" href="{{ item.url }}"><p class="episode-row__number">{{ item.data.number }}</p><div><h3 class="episode-row__title">{{ item.data.title }}</h3><p class="episode-row__text">{{ item.data.description }}</p></div><p class="episode-row__meta">{{ item.data.duration }}</p></a>{% endfor %}</div></div></section>
<section class="section section--surface"><div class="container"><x-use c="section-head" eyebrow="[[Les voix||The hosts]]" title="[[Qui pose les questions||Who asks the questions]]"></x-use><div class="grid grid--2"><x-use c="member" photo="@@host1:800@@" name="Maya Roche" role="[[Animatrice||Host]]"></x-use><x-use c="member" photo="@@host2:800@@" name="Samuel Brun" role="[[Réalisation||Producer]]"></x-use></div><img class="media media--wide studio" src="@@studio:1600@@" alt="@@alt:studio@@"></div></section>
</main>
