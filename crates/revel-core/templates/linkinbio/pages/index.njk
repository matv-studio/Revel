<main class="page bio-page"><img class="bio-page__bg" src="@@bg:1600@@" alt=""><div class="bio-card"><img class="bio-card__photo" src="@@portrait:400@@" alt="@@alt:portrait@@" data-revel-appear="pop"><h1>{{ site.title }}</h1><p class="muted">{{ site.description }}</p><nav class="bio-links">{% for lien in site.menus.links %}<a class="bio-link" href="{{ lien.url }}" data-revel-appear="up" data-revel-hover="grow">{{ lien.label }}</a>{% endfor %}</nav><div class="bio-social">{% for lien in site.menus.social %}<a href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</div></div></main>
