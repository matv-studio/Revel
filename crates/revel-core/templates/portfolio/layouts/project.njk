<main class="page"><section class="project-hero"><div class="container"><p class="eyebrow">{{ category }}</p><h1 data-revel-text="up split=words">{{ title }}</h1><div class="project-facts"><p><span>[[Client||Client]]</span>{{ client }}</p><p><span>[[Année||Year]]</span>{{ year }}</p><p><span>[[Discipline||Discipline]]</span>{{ category }}</p></div></div></section><div class="container"><img class="project-cover" src="{{ image }}" alt="" data-revel-appear="fade dur=1"><div class="project-text"><p class="lead">{{ description }}</p><div class="prose">{{ content | safe }}</div></div><div class="project-gallery" data-revel-masonry>{% for photo in gallery %}<img src="{{ photo }}" alt="" loading="lazy" data-revel-appear="up">{% endfor %}</div></div>
{% for item in (collections.projects | without(page.url) | sort(attribute="order"))[:1] %}<a class="next" href="{{ item.url }}"><p class="eyebrow">[[Projet suivant||Next project]]</p><h2>{{ item.data.title }}</h2></a>{% endfor %}</main>
