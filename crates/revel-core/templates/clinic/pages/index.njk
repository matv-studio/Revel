<main class="page">
<section class="container care-hero"><div class="stack"><p class="eyebrow">{{ site.title }}</p><h1 data-revel-text="up split=words">[[Retrouver le mouvement, sans douleur.||Move again, without pain.]]</h1><p class="lead">{{ site.description }}</p><div class="actions"><a class="btn" href="#[[rendez-vous||appointment]]">[[Prendre rendez-vous||Book an appointment]]</a><a class="btn btn--ghost" href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></div><div class="care-hero__info"><span>[[Conventionné secteur 1||Most insurance accepted]]</span><span>[[Accès fauteuil||Wheelchair access]]</span></div></div><img src="@@hero:1400@@" alt="@@alt:hero@@" data-revel-appear="zoom-in"></section>
<section class="section section--surface treatments" id="[[soins||treatments]]"><div class="container"><x-use c="section-head" eyebrow="[[Soins||Treatments]]" title="[[Ce que nous soignons||What we treat]]"></x-use><div class="grid grid--3"><x-use c="feature" title="[[Dos et cervicales||Back and neck]]" text="[[Douleurs chroniques, posture, travail sur écran.||Chronic pain, posture, desk work.]]" data-revel-appear="up">@@icon:utilisateur@@</x-use><x-use c="feature" title="[[Sport||Sport]]" text="[[Entorses, tendinites, reprise après blessure.||Sprains, tendinitis, return after injury.]]" data-revel-appear="up delay=0.1">@@icon:trophee@@</x-use><x-use c="feature" title="[[Après opération||After surgery]]" text="[[Genou, épaule, hanche : rééducation suivie.||Knee, shoulder, hip: guided rehabilitation.]]" data-revel-appear="up delay=0.2">@@icon:coeur@@</x-use></div></div></section>
<section class="section" id="[[equipe||team]]"><div class="container"><x-use c="section-head" eyebrow="[[Équipe||Team]]" title="[[Vos praticiens||Your practitioners]]"></x-use><div class="grid grid--3"><x-use c="member" photo="@@doctor1:800@@" name="Dr Sophie Klein" role="[[Kinésithérapeute, sport||Physiotherapist, sport]]"></x-use><x-use c="member" photo="@@doctor2:800@@" name="Marc Weber" role="[[Kinésithérapeute, rachis||Physiotherapist, spine]]"></x-use><x-use c="member" photo="@@care:800@@" name="[[Le cabinet||The practice]]" role="[[Trois salles équipées||Three equipped rooms]]"></x-use></div></div></section>
<section class="section section--surface" id="infos"><div class="container practical"><div><h3>[[Horaires||Hours]]</h3><p>{{ site.hours }}</p></div><div><h3>[[Adresse||Address]]</h3><p>{{ site.address }}</p></div><div><h3>Contact</h3><a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></div></div></section>
<section class="section"><div class="container faqs"><x-use c="section-head" variant="center" eyebrow="FAQ" title="[[Avant votre séance||Before your session]]"></x-use><x-use c="faq" question="[[Faut-il une ordonnance ?||Do I need a prescription?]]"><p>[[Oui, pour un remboursement par l'Assurance maladie.||Only for insurance reimbursement.]]</p></x-use><x-use c="faq" question="[[Que dois-je apporter ?||What should I bring?]]"><p>[[Vos examens récents et une tenue confortable.||Recent scans and comfortable clothes.]]</p></x-use></div></section>
<section class="section section--surface" id="[[rendez-vous||appointment]]"><div class="container"><x-use c="section-head" eyebrow="[[Rendez-vous||Appointment]]" title="[[Demander un créneau||Request a time slot]]" text="[[Nous vous rappelons dans la journée pour confirmer.||We call you back the same day to confirm.]]"></x-use><form class="form form--narrow" data-revel-form="[[rendez-vous||appointment]]"><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" autocomplete="name" required></label><label class="field"><span class="field__label">[[Téléphone||Phone]]</span><input class="field__input" type="tel" name="[[telephone||phone]]" autocomplete="tel" required></label></div><div class="form__row"><label class="field"><span class="field__label">[[Motif||Reason]]</span><select class="field__input" name="[[motif||reason]]"><option>[[Dos et cervicales||Back and neck]]</option><option>Sport</option><option>[[Après opération||After surgery]]</option><option>[[Autre||Other]]</option></select></label><label class="field"><span class="field__label">[[Disponibilités||Availability]]</span><input class="field__input" type="text" name="[[disponibilites||availability]]" placeholder="[[ex. mardi matin||e.g. Tuesday morning]]"></label></div><button class="btn" type="submit">[[Envoyer la demande||Send request]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
