<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body class="viewer-page">
<main class="viewer"><div data-revel-base="model" class="viewer__model" data-model="{{ model }}" data-model-poster="{{ poster }}" data-model-pitch="12" data-model-shadow="0.5" data-model-stats data-revel-widget><div data-revel-part="controls"><button data-revel-part="button" type="button" data-model-do="layers" aria-label="[[Calques||Layers]]" title="[[Calques||Layers]]"><svg data-revel-part="svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path data-revel-part="path" d="M12 3 3 8l9 5 9-5zM3 12.5l9 5 9-5M3 17l9 5 9-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button data-revel-part="button" type="button" data-model-do="reset" aria-label="[[Recadrer||Reset view]]" title="[[Recadrer||Reset view]]"><svg data-revel-part="svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path data-revel-part="path" d="M3 12a9 9 0 1 0 2.6-6.4M3 4v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button data-revel-part="button" type="button" data-model-do="fullscreen" aria-label="[[Plein écran||Full screen]]" title="[[Plein écran||Full screen]]"><svg data-revel-part="svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path data-revel-part="path" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div><header class="viewer__bar"><a class="viewer__back" href="/">@@icon:fleche-gauche@@<span>[[Galerie||Gallery]]</span></a><button class="viewer__menu-btn" type="button" data-revel-on="click class:is-open .viewer">@@icon:grille@@<span>[[Modèles||Models]]</span></button></header><div class="viewer__info"><p class="viewer__text">{{ description }}</p><p class="viewer__credit">{{ author }} · {{ license }} · <a class="viewer__credit-link" href="{{ source }}">[[Source||Source]]</a></p></div><nav class="viewer__nav" aria-label="[[Modèles voisins||Neighboring models]]"><a class="viewer__arrow" href="{{ (collections.models | getPreviousCollectionItem(page, true)).url }}" aria-label="[[Modèle précédent||Previous model]]">@@icon:chevron-gauche@@</a><a class="viewer__arrow" href="{{ (collections.models | getNextCollectionItem(page, true)).url }}" aria-label="[[Modèle suivant||Next model]]">@@icon:chevron-droite@@</a></nav><aside class="viewer__panel" aria-label="[[Modèles||Models]]"><div class="viewer__panel-head"><h2 class="viewer__panel-title">[[Modèles||Models]]</h2><button class="viewer__close" type="button" aria-label="[[Fermer le menu||Close the menu]]" data-revel-on="click class:is-open .viewer">@@icon:croix@@</button></div><nav class="viewer__list">{% for item in collections.models %}<a class="viewer__item" href="{{ item.url }}"><img class="viewer__thumb" src="{{ item.data.poster }}" alt="" loading="lazy"><span class="viewer__item-text"><span class="viewer__item-name">{{ item.data.title }}</span><span class="viewer__item-category">{{ item.data.category }}</span></span></a>{% endfor %}</nav></aside><button class="viewer__scrim" type="button" tabindex="-1" aria-label="[[Fermer le menu||Close the menu]]" data-revel-on="click class:is-open .viewer"></button></main>
</body>
</html>
