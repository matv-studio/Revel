<main class="page">
<section class="craft-hero"><div class="craft-hero__text"><p class="eyebrow">{{ site.title }}</p><h1 data-revel-text="up split=words">[[Du bois, du temps, et du travail bien fait.||Wood, time, and work done right.]]</h1><p class="lead">{{ site.description }}</p><div class="badges"><span class="tag">[[Garantie décennale||10-year guarantee]]</span><span class="tag">[[Devis gratuit sous 48 h||Free quote within 48 h]]</span><span class="tag">{{ site.area }}</span></div><div class="actions"><a class="btn" href="#[[devis||quote]]">[[Demander un devis||Get a quote]]</a><a class="btn btn--ghost" href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></div></div><img class="craft-hero__image" src="@@hero:1600@@" alt="@@alt:hero@@"></section>
<section class="section section--surface" id="[[savoir-faire||services]]"><div class="container"><x-use c="section-head" eyebrow="[[Savoir-faire||Services]]" title="[[Ce que nous fabriquons||What we make]]"></x-use><div class="grid grid--3"><x-use c="feature" title="[[Cuisines sur mesure||Custom kitchens]]" text="[[Conçues avec vous, fabriquées à l'atelier.||Designed with you, built in our workshop.]]">@@icon:maison@@</x-use><x-use c="feature" title="[[Escaliers et parquets||Stairs and floors]]" text="[[Chêne, noyer, frêne : bois locaux.||Oak, walnut, ash: local timber.]]">@@icon:calques@@</x-use><x-use c="feature" title="[[Rénovation complète||Full renovation]]" text="[[Un seul interlocuteur pour tous les corps de métier.||One contact for every trade.]]">@@icon:parametres@@</x-use></div></div></section>
<section class="section" id="[[realisations||work]]"><div class="container"><div class="before-after"><div class="reveal" data-revel-reveal="wipe"><img class="reveal__before" src="@@work4:1400@@" alt="@@alt:work4@@"><img class="reveal__after" src="@@work1:1400@@" alt="@@alt:work1@@"></div><div class="stack"><p class="eyebrow">[[Avant / après||Before / after]]</p><h2>[[Glissez sur l'image||Move across the picture]]</h2><p class="lead">[[Une maison des années 60 transformée en six semaines : cuisine ouverte, parquet, bibliothèque.||A 1960s house transformed in six weeks: open kitchen, floors, built-in shelves.]]</p></div></div><div class="grid grid--3 craft-cards"><x-use c="card" image="@@work2:900@@" title="[[Cuisine en chêne||Oak kitchen]]" link="#[[devis||quote]]"><p>[[Nantes, 2026||Nantes, 2026]]</p></x-use><x-use c="card" image="@@work3:900@@" title="[[Mobilier sur mesure||Custom furniture]]" link="#[[devis||quote]]"><p>[[Rennes, 2025||Rennes, 2025]]</p></x-use><x-use c="card" image="@@tools:900@@" title="[[L'atelier||The workshop]]" link="#[[devis||quote]]"><p>[[600 m² de machines||6,500 sq ft of machinery]]</p></x-use></div></div></section>
<section class="section section--surface"><div class="container grid grid--2"><div class="grid grid--2"><x-use c="stat" value="1998" label="[[année de création||founded]]"></x-use><x-use c="stat" value="900+" label="[[chantiers||projects]]"></x-use></div><x-use c="testimonial" quote="[[Travail impeccable, chantier propre et délais respectés.||Flawless work, tidy site and on schedule.]]" name="M. et Mme Robin" role="[[Rénovation d'une longère||Farmhouse renovation]]" avatar="@@saas/avatar2:160@@"></x-use></div></section>
<section class="section" id="[[devis||quote]]"><div class="container"><x-use c="section-head" eyebrow="[[Devis||Quote]]" title="[[Parlez-nous de votre projet||Tell us about your project]]" x-text="site.area"></x-use><form class="form form--narrow" data-revel-form="devis"><div class="form__row"><label class="field"><span class="field__label">[[Nom||Name]]</span><input class="field__input" type="text" name="[[nom||name]]" required></label><label class="field"><span class="field__label">[[Téléphone||Phone]]</span><input class="field__input" type="tel" name="[[telephone||phone]]" required></label></div><div class="form__row"><label class="field"><span class="field__label">[[Type de travaux||Type of work]]</span><select class="field__input" name="[[travaux||work]]"><option>[[Cuisine||Kitchen]]</option><option>[[Escalier||Staircase]]</option><option>[[Parquet||Flooring]]</option><option>[[Rénovation complète||Full renovation]]</option></select></label><label class="field"><span class="field__label">[[Ville||Town]]</span><input class="field__input" type="text" name="[[ville||town]]"></label></div><label class="field"><span class="field__label">[[Votre projet||Your project]]</span><textarea class="field__input" name="message" rows="5" required></textarea></label><button class="btn" type="submit">[[Recevoir mon devis||Get my quote]]</button><p class="form__status" data-revel-form-status role="status" aria-live="polite"></p></form></div></section>
</main>
