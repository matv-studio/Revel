<div class="progress" data-revel-progress="page" aria-hidden="true"><div class="progress__fill"></div></div>
<main class="page"><article class="story"><p class="kicker">{{ section }}</p><h1>{{ title }}</h1><p class="story__dek">{{ description }}</p><p class="story__meta">{{ author }} · {{ date | date_text(locale, "long") }}</p><img class="story__image" src="{{ image }}" alt=""><div class="prose">{{ content | safe }}</div></article>
<section class="section section--surface"><div class="container"><x-use c="section-head" eyebrow="[[À lire aussi||Read next]]" title="[[Dans la même édition||In this edition]]"></x-use><div class="stories">{% for item in (collections.stories | without(page.url) | sort(attribute="date", reverse=true))[:4] %}<a class="story-card" href="{{ item.url }}"><img src="{{ item.data.image }}" alt="" loading="lazy"><p class="kicker">{{ item.data.section }}</p><h3>{{ item.data.title }}</h3></a>{% endfor %}</div></div></section></main>
