<footer class="footer"><div class="footer__inner"><div class="footer__brand"><a class="footer__name" href="/">{{ site.title }}</a><p class="footer__text">{{ site.description }}</p></div><nav class="footer__nav">{% for lien in site.menus.main %}<a class="footer__link" href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</nav><div class="footer__contact"><a class="footer__link" href="mailto:{{ site.email }}">{{ site.email }}</a><a class="footer__link" href="tel:{{ site.phone | tel }}">{{ site.phone }}</a><p class="footer__address">{{ site.address }}</p><div class="footer__social">{% for lien in site.menus.social %}<a class="footer__link" href="{{ lien.url }}">{{ lien.label }}</a>{% endfor %}</div></div></div><div class="footer__bottom"><p>© {{ now() | date("%Y") }} {{ site.title }}</p></div></footer>
