<main class="page">
<section class="page-hero section--tight"><div class="container"><p class="eyebrow">[[Boutique||Shop]]</p><h1>[[Toute la collection||The whole collection]]</h1></div></section>
<section class="section section--tight"><div class="container"><div class="filters" data-revel-filters="categorie"><button class="filter" type="button" data-revel-filter="">[[Tout||All]]</button><button class="filter" type="button" data-revel-filter="[[Table||Tableware]]">[[Table||Tableware]]</button><button class="filter" type="button" data-revel-filter="[[Décoration||Decor]]">[[Décoration||Decor]]</button><button class="filter" type="button" data-revel-filter="[[Maison||Home]]">[[Maison||Home]]</button></div><div class="products" data-revel-more="8">{% for item in collections.products | sort(attribute="order") %}<div data-revel-tags="{{ item.data.category }}"><x-use c="product-card" x-image="item.data.image" x-title="item.data.title" x-price="item.data.price" x-link="item.url"></x-use></div>{% endfor %}</div></div></section>
</main>
